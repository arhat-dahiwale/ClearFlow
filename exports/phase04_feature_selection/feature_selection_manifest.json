  "training_rows_scanned": 2020546,
  "selection_sample_rows": 70245,
  "selection_sample_strategy": "Uniform per-class reservoir sample drawn from the training split only; up to max_rows_per_class rows per class. The same sample is used for all selectors.",
  "max_rows_per_class": 10000,
  "sample_random_state": 42,
  "rfe_step_fraction": 0.2,
  "methods": [
    {
      "id": "rf_importance",
      "name": "Random Forest Importance",
      "implementation": "RandomForestClassifier feature_importances_",
      "parameters": {
        "n_estimators": 200,
        "max_features": "sqrt",
        "min_samples_leaf": 2,
        "class_weight": "balanced_subsample",
        "random_state": 42
      }
    },
    {
      "id": "anova_f_test",
      "name": "ANOVA F-test",
      "implementation": "sklearn.feature_selection.f_classif",
      "notes": "Selected instead of chi-square because features are continuous and need not be non-negative."
    },
    {
      "id": "rfe_decision_tree",
      "name": "RFE (Decision Tree)",
      "implementation": "Recursive elimination using DecisionTreeClassifier feature_importances_",
      "parameters": {
        "max_depth": 18,
        "min_samples_leaf": 5,
        "class_weight": "balanced",
        "step_fraction": 0.2,
        "random_state": 42
      }
    }
  ],
  "feature_set_sizes": [
    10,
    20,
    40
  ],
  "feature_set_count": 10,
  "feature_sets": [
